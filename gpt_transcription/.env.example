OPENAI_API_KEY=your_openai_api_key_here

APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

DATABASE_PATH=./data/realtime_transcription.sqlite3

# Realtime WebSocket transport model
REALTIME_WS_MODEL=gpt-realtime

# Transcription model used inside the realtime transcription session
# If you hit model availability issues, try gpt-4o-transcribe-latest.
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

QA_MODEL=gpt-5-mini
SUMMARY_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPT_LANGUAGE=en
TRANSCRIPTION_PROMPT=Transcribe lecture audio accurately. Preserve terminology, formulas, named entities, and code terms. Use natural punctuation.

OPENAI_REALTIME_VAD_THRESHOLD=0.5
OPENAI_REALTIME_PREFIX_PADDING_MS=300
OPENAI_REALTIME_SILENCE_MS=500

DEFAULT_SUMMARY_MODE=time
DEFAULT_SUMMARY_INTERVAL_SECONDS=300
DEFAULT_TOPIC_SIMILARITY_THRESHOLD=0.72

FINAL_TRANSCRIPT_MAX_PENDING_SECONDS=20
FINAL_TRANSCRIPT_MAX_PENDING_CHARS=240
